          "legendFormat": "{{job}} p99"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=~\"service-a|service-b\"}[5m])) by (le, job))",
          "legendFormat": "{{job}} p95"
        }
      ],
