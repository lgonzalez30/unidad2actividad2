        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"service-a|service-b\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=~\"service-a|service-b\"}[5m])), 1)",
          "legendFormat": "5xx"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"service-a|service-b\", status=~\"4..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=~\"service-a|service-b\"}[5m])), 1)",
          "legendFormat": "4xx"
        }
      ],
      "title": "SLI 3 - Error rate",
